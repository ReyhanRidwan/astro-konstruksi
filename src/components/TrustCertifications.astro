---
// Legal certifications, Quality & Safety standards
const certs = [
  {
    code: "SBU B2",
    title: "Sertifikat Badan Usaha (SBU)",
    authority: "LPJK / Kementerian PUPR RI",
    desc: "Kualifikasi Besar (B2) dengan izin menangani proyek konstruksi skala nasional hingga nilai tak terbatas."
  },
  {
    code: "ISO 9001",
    title: "Sistem Manajemen Mutu",
    authority: "Akreditasi KAN & UKAS",
    desc: "Standar audit mutu berkala untuk seluruh siklus pengadaan material, pengujian slump beton, dan toleransi struktur."
  },
  {
    code: "SMK3 Gold",
    title: "K3 Konstruksi & ISO 45001",
    authority: "Kementerian Ketenagakerjaan RI",
    desc: "Sertifikat Bendera Emas K3 dengan rekor Zero Fatal Accident serta kepatuhan APD dan safety briefing harian."
  },
  {
    code: "ISO 14001",
    title: "Manajemen Lingkungan",
    authority: "Environmental Compliance",
    desc: "Pengelolaan limbah konstruksi ramah lingkungan, reduksi polusi debu, dan efisiensi energi terukur."
  }
];
---

<section id="standar-mutu" class="py-20 bg-[#0b1329] border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mb-14">
      <div class="text-xs font-semibold uppercase tracking-widest text-amber-400 mb-2">
        Kepatuhan & Integritas Hukum
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight mb-4">
        Legalitas Konstruksi Resmi & Standar Keselamatan Kerja
      </h2>
      <p class="text-sm text-slate-300 leading-relaxed">
        Ketenangan pikiran bagi pemilik proyek melalui kepatuhan regulasi konstruksi Republik Indonesia, jaminan Bank Garansi terpercaya, dan sertifikasi sistem mutu internasional.
      </p>
    </div>

    <!-- 4 Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      {certs.map(cert => (
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 hover:border-slate-700 transition-colors">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono font-bold text-amber-400 bg-amber-400/10 px-2.5 py-1 rounded border border-amber-400/20">
              {cert.code}
            </span>
            <svg class="w-5 h-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="text-base font-bold text-white mb-1">
            {cert.title}
          </h3>
          <div class="text-[11px] font-semibold text-slate-400 mb-3">
            {cert.authority}
          </div>
          <p class="text-xs text-slate-300 leading-relaxed">
            {cert.desc}
          </p>
        </div>
      ))}
    </div>

    <!-- Trust Markers Bar (GAPENSI, LPJK, CAR Insurance) -->
    <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-6 sm:p-8 flex flex-wrap items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-lg bg-amber-400/10 border border-amber-400/30 flex items-center justify-center text-amber-400 shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-bold text-white mb-0.5">
            Asuransi & Jaminan Pelaksanaan Penuh (Bonding)
          </h4>
          <p class="text-xs text-slate-400">
            Didukung Bank Garansi Himbara (Mandiri, BNI, BRI) serta Polis Contractor's All Risks (CAR).
          </p>
        </div>
      </div>

      <div class="flex items-center gap-4 text-xs font-mono text-slate-300">
        <span class="px-3 py-1.5 bg-slate-950 rounded border border-slate-800">
          NIB: 9120004928172
        </span>
        <span class="px-3 py-1.5 bg-slate-950 rounded border border-slate-800">
          SBU: 0-3171-08-011-1
        </span>
      </div>
    </div>

  </div>
</section>
