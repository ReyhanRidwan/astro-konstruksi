  {
    id: "proj-1",
    category: "komersial",
    categoryLabel: "Gedung Komersial",
    title: "Menara Kantor Nusantara Nexus",
    location: "Kuningan, Jakarta Selatan",
    image: "/images/komersial.jpg",
    value: "Rp 385 Miliar",
    area: "42.000 m² (25 Lantai)",
    duration: "18 Bulan (Selesai Tepat Waktu)",
    specs: "Struktur beton bertulang K-500, double glazing Low-E glass facade, sertifikasi Greenship Gold.",
    year: "2024"
  },
  {
    id: "proj-2",
    category: "industri",
    categoryLabel: "Fasilitas Industri",
    title: "Cikarang Mega Logistics Hub",
    location: "Kawasan Industri GIIC, Cikarang",
    image: "/images/industri.jpg",
    value: "Rp 210 Miliar",
    area: "68.500 m² Bangunan Gudang",
    duration: "11 Bulan",
    specs: "Rangka baja portal frame bentang 36m, lantai superflat FF 50 / FL 40, sistem proteksi sprinkler ESFR.",
    year: "2024"
  },
  {
    id: "proj-3",
    category: "sipil",
    categoryLabel: "Infrastruktur Sipil",
    title: "Interchange Tol Elevated Segmen Barat",
    location: "Jawa Timur",
    image: "/images/sipil.jpg",
    value: "Rp 540 Miliar",
    area: "3.4 km Jalur Layang",
    duration: "24 Bulan",
    specs: "Pondasi bore pile dia. 1200mm, PCI Girder bentang 40m prategang, perkerasan rigid K-400.",
    year: "2023"
  },
  {
    id: "proj-4",
    category: "industri",
    categoryLabel: "Fasilitas Industri",
    title: "Pabrik Manufaktur Otomotif & Workshop",
    location: "Karawang International Industrial City",
    image: "/images/industri.jpg",
    value: "Rp 175 Miliar",
    area: "28.000 m²",
    duration: "9 Bulan",
    specs: "Struktur heavy steel, overhead crane 20 Ton, substation kelistrikan 2.5 MVA.",
    year: "2023"
  },
  {
    id: "proj-5",
    category: "komersial",
    categoryLabel: "Gedung Komersial",
    title: "Pusat Perbelanjaan & Lifestyle Arcade",
    location: "Surabaya Barat",
    image: "/images/komersial.jpg",
    value: "Rp 290 Miliar",
    area: "35.000 m² (5 Lantai + 2 Basement)",
    duration: "16 Bulan",
    specs: "Metode Top-Down basement excavation, atrium skylight bentang bebas 24m.",
