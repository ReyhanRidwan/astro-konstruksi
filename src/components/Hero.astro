---
// Hero component featuring authentic Indonesian architectural construction photography
---

<section id="beranda" class="relative pt-6 pb-20 md:pt-12 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Main Stage with Background Image -->
    <div class="relative rounded-2xl overflow-hidden border border-slate-800 bg-slate-900 shadow-2xl">
      
      <!-- Photography backdrop with measured contrast scrim -->
      <div class="absolute inset-0 z-0">
        <img
          src="/images/hero.jpg"
          alt="Proyek Konstruksi Gedung Bertingkat di Indonesia oleh PT Mahakarya Bangun Nusantara"
          class="w-full h-full object-cover object-center opacity-40 scale-105 transition-transform duration-1000 ease-out"
          loading="eager"
          referrerpolicy="no-referrer"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0b1329] via-[#0b1329]/75 to-transparent"></div>
        <div class="absolute inset-0 bg-radial from-transparent via-[#0b1329]/40 to-[#0b1329]"></div>
      </div>

      <!-- Foreground Content -->
      <div class="relative z-10 p-8 sm:p-12 md:p-16 lg:p-20 max-w-4xl">
        
        <!-- Quiet Kicker (No Pill Enclosures) -->
        <div class="flex items-center gap-2 text-xs font-semibold tracking-widest uppercase text-amber-400 mb-4">
          <span>Kontraktor Terdaftar Kualifikasi B2</span>
          <span aria-hidden="true" class="text-slate-600">·</span>
          <span>SBU LPJK RI</span>
          <span aria-hidden="true" class="text-slate-600">·</span>
          <span>ISO 9001:2015</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.12] text-balance mb-6">
          Membangun Fondasi Masa Depan Konstruksi Indonesia
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl mb-8">
          Mitra kontraktor umum dan rekayasa konstruksi terpercaya untuk pembangunan gedung komersial, pabrik & pergudangan modern, serta pekerjaan sipil strategis dengan jaminan mutu teruji, efisiensi anggaran, dan nol kecelakaan kerja.
        </p>

        <!-- CTA Action Group -->
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="#kalkulator-rab"
            class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-bold uppercase tracking-wider text-slate-950 bg-amber-400 hover:bg-amber-300 active:scale-[0.98] rounded-md transition-all shadow-lg shadow-amber-500/20 whitespace-nowrap"
          >
            Hitung Estimasi RAB Awal
          </a>
          <a
            href="#portofolio"
            class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold text-white bg-slate-800/90 hover:bg-slate-700/90 border border-slate-700 rounded-md transition-all whitespace-nowrap"
          >
            Lihat Portofolio Proyek
          </a>
        </div>

      </div>

      <!-- Live Project Trust Bar -->
      <div class="relative z-10 border-t border-slate-800/80 bg-slate-950/80 backdrop-blur px-8 py-4 flex flex-wrap items-center justify-between gap-4 text-xs text-slate-400">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Kesiapan Operasional: Proyek Aktif di Jabodetabek, Jawa Timur & IKN</span>
        </div>
        <div class="flex items-center gap-4">
          <span>Sertifikasi: SNI / ASTM Compliant</span>
          <span aria-hidden="true">·</span>
          <span>Garansi Struktur 10 Tahun</span>
        </div>
      </div>

    </div>

    <!-- 4-Column KPI Metric Strip (Below the Hero Split) -->
    <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      
      <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-6 hover:border-slate-700 transition-colors">
        <div class="text-3xl sm:text-4xl font-extrabold text-white font-mono tabular-nums tracking-tight mb-1">
          140+
        </div>
        <div class="text-xs uppercase tracking-wider font-semibold text-amber-400 mb-1">
          Proyek Selesai
        </div>
        <div class="text-xs text-slate-400">
          Gedung komersial, pabrik, & fasilitas sipil
        </div>
      </div>

      <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-6 hover:border-slate-700 transition-colors">
        <div class="text-3xl sm:text-4xl font-extrabold text-white font-mono tabular-nums tracking-tight mb-1">
          Rp 3.2T+
        </div>
        <div class="text-xs uppercase tracking-wider font-semibold text-amber-400 mb-1">
          Total Nilai Konstruksi
        </div>
        <div class="text-xs text-slate-400">
          Akumulasi portofolio kontrak terlaksana
        </div>
      </div>

      <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-6 hover:border-slate-700 transition-colors">
        <div class="text-3xl sm:text-4xl font-extrabold text-white font-mono tabular-nums tracking-tight mb-1">
          0 Fatal
        </div>
        <div class="text-xs uppercase tracking-wider font-semibold text-amber-400 mb-1">
          Zero Accident Award
        </div>
        <div class="text-xs text-slate-400">
          Penerapan ketat SMK3 & ISO 45001:2018
        </div>
      </div>

      <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-6 hover:border-slate-700 transition-colors">
        <div class="text-3xl sm:text-4xl font-extrabold text-white font-mono tabular-nums tracking-tight mb-1">
          99.4%
        </div>
        <div class="text-xs uppercase tracking-wider font-semibold text-amber-400 mb-1">
          Ketepatan Waktu
        </div>
        <div class="text-xs text-slate-400">
          Disiplin manajemen kurva-S & CPM schedule
        </div>
      </div>

    </div>

  </div>
</section>
