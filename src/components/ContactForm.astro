---
// Lead Capture & Tender RFP Submission Component
---

<section id="kontak" class="py-20 bg-[#090f20] border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Contact Info & Operational Presence (5 cols) -->
      <div class="lg:col-span-5 space-y-8">
        <div>
          <div class="text-xs font-semibold uppercase tracking-widest text-amber-400 mb-2">
            Konsultasi & Pengajuan Tender
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight mb-4">
            Mulai Diskusi Proyek Anda Bersama Tim Enjiniring Kami
          </h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            Kirimkan berkas kerangka acuan kerja (KAK/TOR) atau jadwalkan survei lokasi teknis. Tim estimator kami siap memberikan tanggapan dalam waktu 1x24 jam kerja.
          </p>
        </div>

        <!-- Office Addresses -->
        <div class="space-y-4">
          
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
            <div class="text-xs font-bold text-amber-400 uppercase tracking-wider mb-1">
              Kantor Pusat (Head Office)
            </div>
            <h4 class="text-sm font-bold text-white mb-1">
              Equity Tower, Lantai 28
            </h4>
            <p class="text-xs text-slate-300 leading-relaxed">
              Sudirman Central Business District (SCBD) Lot 9, Jl. Jend. Sudirman Kav. 52-53, Jakarta Selatan 12190
            </p>
            <div class="mt-3 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400 font-mono">
              <span>Tel: (021) 515-8900</span>
              <span>info@mahakaryakonstruksi.co.id</span>
            </div>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
            <div class="text-xs font-bold text-amber-400 uppercase tracking-wider mb-1">
              Kantor Operasional & Workshop
            </div>
            <h4 class="text-sm font-bold text-white mb-1">
              Surabaya & IKN Operations
            </h4>
            <p class="text-xs text-slate-300 leading-relaxed">
              Kawasan Industri SIER, Jl. Rungkut Industri III No. 18, Surabaya, Jawa Timur 60293
            </p>
            <div class="mt-3 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400 font-mono">
              <span>Hotline Tender: 0811-8000-1234</span>
              <span>Jam Operasional: 08.00 - 17.00 WIB</span>
            </div>
          </div>

        </div>

        <!-- Direct WhatsApp Banner -->
        <div class="p-4 rounded-xl bg-amber-400/10 border border-amber-400/30 flex items-center justify-between gap-4">
          <div>
            <div class="text-xs font-bold text-white mb-0.5">
              Butuh Penanganan Cepat untuk Tender Mendesak?
            </div>
            <div class="text-[11px] text-slate-300">
              Hubungi langsung Project Director kami via WhatsApp.
            </div>
          </div>
          <a
            href="https://wa.me/6281180001234?text=Halo%20PT%20Mahakarya%20Bangun%20Nusantara,%20kami%20memiliki%20kebutuhan%20tender%20konstruksi."
            target="_blank"
            rel="noopener noreferrer"
            class="px-3.5 py-2 text-xs font-bold bg-amber-400 text-slate-950 rounded hover:bg-amber-300 transition-colors shrink-0"
          >
            WhatsApp
          </a>
        </div>

      </div>

      <!-- Right Column: Interactive RFP Submission Form (7 cols) -->
      <div class="lg:col-span-7 bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl">
        
        <h3 class="text-xl font-bold text-white mb-2">
          Formulir Permintaan Penawaran (RFP)
        </h3>
        <p class="text-xs text-slate-400 mb-6">
          Isi informasi dasar proyek Anda di bawah ini untuk menerima estimasi formal & jadwal konsultasi teknis.
        </p>

        <!-- Success Toast Alert -->
        <div id="form-success-banner" class="hidden mb-6 p-4 rounded-xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-xs">
          <div class="font-bold flex items-center gap-2 mb-1 text-emerald-200">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Pengajuan Tender Berhasil Diterima!</span>
          </div>
          <p class="leading-relaxed" id="form-success-text">
            Terima kasih. Tim enjiniring PT Mahakarya Bangun Nusantara akan menelaah data proyek Anda dan menghubungi melalui kontak resmi dalam 1x24 jam kerja.
          </p>
        </div>

        <form id="tender-rfp-form" class="space-y-4">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="form-nama" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
                Nama Lengkap / PIC <span class="text-amber-400">*</span>
              </label>
              <input
                type="text"
                id="form-nama"
                name="nama"
                required
                placeholder="Contoh: Ir. Hendra Gunawan"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3.5 py-2.5 text-xs text-white placeholder:text-slate-500 focus:outline-none focus:border-amber-400 transition-colors"
              />
            </div>

            <div>
              <label for="form-perusahaan" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
                Perusahaan / Instansi <span class="text-amber-400">*</span>
              </label>
              <input
                type="text"
                id="form-perusahaan"
                name="perusahaan"
                required
                placeholder="Contoh: PT Surya Propertindo Tbk"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3.5 py-2.5 text-xs text-white placeholder:text-slate-500 focus:outline-none focus:border-amber-400 transition-colors"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="form-telepon" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
                Nomor WhatsApp / HP <span class="text-amber-400">*</span>
              </label>
              <input
                type="tel"
                id="form-telepon"
                name="telepon"
                required
                placeholder="0812-xxxx-xxxx"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3.5 py-2.5 text-xs text-white placeholder:text-slate-500 focus:outline-none focus:border-amber-400 transition-colors"
              />
            </div>

            <div>
              <label for="form-email" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
                Email Korporat <span class="text-amber-400">*</span>
              </label>
              <input
                type="email"
                id="form-email"
                name="email"
                required
                placeholder="hendra@suryaproperti.co.id"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3.5 py-2.5 text-xs text-white placeholder:text-slate-500 focus:outline-none focus:border-amber-400 transition-colors"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="form-tipe" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
                Kategori Pekerjaan
              </label>
              <select
                id="form-tipe"
                name="tipe"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-amber-400 transition-colors"
              >
                <option value="kantor">Konstruksi Gedung Bertingkat / Kantor</option>
                <option value="gudang">Fasilitas Industri / Gudang Baja</option>
                <option value="sipil">Infrastruktur Sipil / Jalan & Jembatan</option>
                <option value="ruko">Ruko Komersial / Retail</option>
                <option value="epc">Turnkey Design & Build (EPC)</option>
              </select>
            </div>

            <div>
              <label for="form-luas" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
                Lokasi & Estimasi Luas (m²)
              </label>
              <input
                type="text"
                id="form-luas"
                name="luas"
                placeholder="Contoh: Cikarang, 3.500 m²"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3.5 py-2.5 text-xs text-white placeholder:text-slate-500 focus:outline-none focus:border-amber-400 transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="form-pesan" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">
              Rincian Kebutuhan & Catatan Khusus
            </label>
            <textarea
              id="form-pesan"
              name="pesan"
              rows="3"
              placeholder="Jelaskan kebutuhan khusus, target mulai pelaksanaan, atau tautan KAK / gambar arsitektur awal jika tersedia..."
              class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3.5 py-2.5 text-xs text-white placeholder:text-slate-500 focus:outline-none focus:border-amber-400 transition-colors"
            ></textarea>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              id="form-submit-btn"
              class="w-full py-3.5 px-6 text-xs font-bold uppercase tracking-wider text-slate-950 bg-amber-400 hover:bg-amber-300 active:scale-[0.98] rounded-md transition-all shadow-md text-center"
            >
              Kirim Pengajuan Proposal Tender
            </button>
            <p class="text-[11px] text-slate-500 text-center mt-2.5">
              Kerahasiaan data dokumen proyek dijamin di bawah Non-Disclosure Agreement (NDA).
            </p>
          </div>

        </form>

      </div>

    </div>

  </div>
</section>

<script>
  // Pure client validation and feedback
  const form = document.getElementById('tender-rfp-form') as HTMLFormElement;
  const banner = document.getElementById('form-success-banner') as HTMLElement;
  const bannerText = document.getElementById('form-success-text') as HTMLElement;
  const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement;

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const nama = (document.getElementById('form-nama') as HTMLInputElement).value;
      const perusahaan = (document.getElementById('form-perusahaan') as HTMLInputElement).value;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Memproses Pengajuan...';

      setTimeout(() => {
        if (banner && bannerText) {
          bannerText.innerHTML = `Terima kasih Bapak/Ibu <strong>${nama}</strong> dari <strong>${perusahaan}</strong>. Proposal telah tercatat dalam sistem pendaftaran tender kami. Tim tender akan menghubungi Anda melalui kontak yang dicantumkan.`;
          banner.classList.remove('hidden');
          banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        form.reset();
        submitBtn.disabled = false;
        submitBtn.textContent = 'Kirim Pengajuan Proposal Tender';
      }, 700);
    });
  }
</script>
