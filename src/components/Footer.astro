---
// Quiet, professional corporate contractor footer
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#070c1a] border-t border-slate-800 text-slate-400 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 mb-12">
      
      <!-- Brand & Entity Overview (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="#beranda" class="flex items-center gap-2 group whitespace-nowrap">
          <span class="w-8 h-8 rounded bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center font-bold text-slate-950 text-sm">
            M
          </span>
          <span class="text-lg font-bold tracking-tight text-white group-hover:text-amber-400 transition-colors">
            PT Mahakarya Bangun Nusantara
          </span>
        </a>
        <p class="text-slate-400 leading-relaxed max-w-sm">
          Perusahaan kontraktor umum dan rekayasa konstruksi Indonesia terpercaya. Berkomitmen menghadirkan keunggulan struktural, kepatuhan K3 tanpa kompromi, dan ketepatan waktu serah terima proyek.
        </p>
        <div class="space-y-1 font-mono text-[11px] text-slate-400">
          <div>NIB: 9120004928172 | NPWP: 01.345.678.9-054.000</div>
          <div>SBU Konstruksi Kualifikasi B2 (Besar) — LPJK RI</div>
        </div>
      </div>

      <!-- Links: Layanan -->
      <div class="space-y-3">
        <div class="font-bold uppercase tracking-wider text-white text-xs">
          Layanan Konstruksi
        </div>
        <ul class="space-y-2">
          <li><a href="#layanan" class="hover:text-amber-400 transition-colors">Gedung Bertingkat</a></li>
          <li><a href="#layanan" class="hover:text-amber-400 transition-colors">Pabrik & Gudang Baja</a></li>
          <li><a href="#layanan" class="hover:text-amber-400 transition-colors">Infrastruktur Sipil & Jalan</a></li>
          <li><a href="#layanan" class="hover:text-amber-400 transition-colors">Turnkey Design & Build</a></li>
          <li><a href="#layanan" class="hover:text-amber-400 transition-colors">Fit-Out Komersial</a></li>
        </ul>
      </div>

      <!-- Links: Portofolio & Legalitas -->
      <div class="space-y-3">
        <div class="font-bold uppercase tracking-wider text-white text-xs">
          Kredensial & Proyek
        </div>
        <ul class="space-y-2">
          <li><a href="#portofolio" class="hover:text-amber-400 transition-colors">Portofolio Komersial</a></li>
          <li><a href="#portofolio" class="hover:text-amber-400 transition-colors">Portofolio Industri</a></li>
          <li><a href="#standar-mutu" class="hover:text-amber-400 transition-colors">Sertifikasi ISO 9001:2015</a></li>
          <li><a href="#standar-mutu" class="hover:text-amber-400 transition-colors">Standar K3 & SMK3 Emas</a></li>
          <li><a href="#kalkulator-rab" class="hover:text-amber-400 transition-colors">Simulasi Biaya RAB</a></li>
        </ul>
      </div>

      <!-- Links: Kontak & Wilayah Kerja -->
      <div class="space-y-3">
        <div class="font-bold uppercase tracking-wider text-white text-xs">
          Wilayah Kerja Aktif
        </div>
        <ul class="space-y-2 text-slate-400">
          <li>DKI Jakarta & Bodetabek</li>
          <li>Kawasan Industri Jawa Barat</li>
          <li>Jawa Timur & Surabaya</li>
          <li>Wilayah IKN Nusantara</li>
          <li>Kawasan Industri Luar Jawa</li>
        </ul>
      </div>

    </div>

    <!-- Bottom Legal Bar -->
    <div class="pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-slate-400">
      <div>
        &copy; {currentYear} PT Mahakarya Bangun Nusantara. Hak Cipta Dilindungi Undang-Undang Republik Indonesia.
      </div>
      <div class="flex items-center gap-6">
        <a href="#beranda" class="hover:text-slate-300 transition-colors">Kebijakan Privasi</a>
        <a href="#beranda" class="hover:text-slate-300 transition-colors">Ketentuan Layanan</a>
        <a href="#beranda" class="hover:text-slate-300 transition-colors">Pakta Integritas K3</a>
      </div>
    </div>

  </div>
</footer>
